# Copy to .env, fill in, and never commit .env.
# Generate UUIDs with:  uuidgen | tr 'A-Z' 'a-z'

# --- Mailbox (Purelymail) ---------------------------------------------------
# Create a NEW Purelymail user named <uuid>@yourdomain and use its credentials.
IMAP_HOST=imap.purelymail.com
IMAP_USER=00000000-0000-0000-0000-000000000000@blackinksecurity.com
IMAP_PASSWORD=

# --- Trust gate ---------------------------------------------------------------
# Comma-separated email addresses allowed to submit receipts.
ALLOWED_SENDERS=kevin@example.com,kevin@blackinksecurity.com
# Second UUID: must appear in the subject or body of every receipt email.
# Tip: add a phone keyboard text-replacement (e.g. ";rcpt" -> this value).
BEARER_TOKEN=00000000-0000-0000-0000-000000000000

# --- Claude API ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Cost reporting (optional). Anthropic has no balance API; the app subtracts
# its own tracked spend from the balance you last synced. Preferred sync:
#   docker compose exec tax-assistant python -m tax_assistant.cli set-balance 23.45
# These two are an optional .env alternative (newest anchor wins). Leave blank
# to hide the remaining-balance line.
#CLAUDE_BALANCE_USD=25.00
#CLAUDE_BALANCE_AS_OF=2026-07-17

# --- Notifications & monitoring ----------------------------------------------
# pushover.net -> your user key, plus an application token you create there.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# healthchecks.io ping URL for a check configured: period 5 min, grace 10 min.
HEALTHCHECKS_URL=

# --- Web UI -------------------------------------------------------------------
WEB_PASSWORD=
# Pin so logins survive container restarts:  openssl rand -hex 32
SESSION_SECRET=

# --- Tuning (defaults shown) ---------------------------------------------------
#POLL_INTERVAL_SECONDS=300
#MAX_EMAILS_PER_DAY=100
#MAX_ATTACHMENT_MB=15
#MAX_ATTACHMENTS_PER_EMAIL=10
#SESSION_MAX_AGE_DAYS=30
#LOG_LEVEL=INFO
